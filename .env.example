# Copy to .env; secrets stay on the server and must not be committed.
MONITOR_PORT=8787
MONITOR_DB=data/monitor.sqlite3
# Optional authenticated LAN gateway; start with ./start-mobile.sh.
MONITOR_MOBILE_PORT=8788
# MONITOR_MOBILE_HOSTS=monitor.example.com
# Pairing key is generated in data/mobile-key.secret; never commit it.
# Choose the no-token public source in Settings; it needs no configuration.
# Tushare is optional and requires the appropriate data permissions.
TUSHARE_TOKEN=
# Optional email delivery. Without these, alerts remain in the in-app inbox.
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
ALERT_EMAIL=
